# Load this file through netfilter_manager.sh (add-rules). The script replaces the table atomically,
# so the rules are never duplicated and there is no moment without them.

# Tailscale DNS resolver (MagicDNS)
define RESOLVER_ADDRS = {
    100.100.100.100
}

# Tailscale devices this server is allowed to open connections to.
# EXAMPLE VALUES - replace them with Tailscale IPs of your machines (available at login.tailscale.com/admin/machines)
# Incoming connections from the tailnet are allowed regardless of this list.
define EXCLUDED_IPS = {
    100.101.102.103,
    100.104.105.106
}

# https://mullvad.net/en/help/split-tunneling-with-linux-advanced
#
# Mullvad firewall (table inet mullvad) hooks at priority 0 and lets through only connections
# marked with ct mark 0x00000f41. All chains below have to run BEFORE it, so they use
# a priority lower than 0. With the same priority, the order would depend on which table was
# loaded last, and it would change whenever Mullvad reloads its table.
#
# Outgoing packets need meta mark 0x6d6f6c65 as well, otherwise Mullvad routing rules may send them
# into the Mullvad tunnel instead of tailscale0 (depends on the order in which Mullvad and Tailscale
# added their 'ip rule' entries). The mark changes the route only in chains of type 'route'.
table inet mullvad-tailscale {
    chain excludeOutgoing {
        type route hook output priority -100; policy accept;
        # Replies to connections accepted in allow-incoming chain (whole tailnet, IPv4 and IPv6)
        ct direction reply ct mark 0x00000f41 meta mark set 0x6d6f6c65;
        # Exclude outgoing Tailscale connection
        ip daddr $EXCLUDED_IPS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    }

    # Allow incoming Tailscale connection
    chain allow-incoming {
        type filter hook input priority -100; policy accept;
        iifname "tailscale0" ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    }

    # Exclude Tailscale DNS
    # Needed only if the server uses Tailscale DNS (tailscale up --accept-dns=true, which is the default)
    chain excludeDns {
        type route hook output priority -100; policy accept;
        ip daddr $RESOLVER_ADDRS udp dport 53 ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
        ip daddr $RESOLVER_ADDRS tcp dport 53 ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    }
}
